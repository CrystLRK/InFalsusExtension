<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>InFalsusChartExt</AssemblyName>
    <RootNamespace>InFalsusChartExt</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8500</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''"></GameDir>
    <MlDir>$(GameDir)\MelonLoader\net6</MlDir>
    <Il2CppDir>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppDir>
    <StagedDir>$(GameDir)\MelonLoader\Dependencies\Il2CppAssemblyGenerator\Il2CppInterop\Il2CppAssemblies</StagedDir>
  </PropertyGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir is required. Pass -p:GameDir=&quot;&lt;path to In Falsus&gt;&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MlDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MlDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MlDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGame"><HintPath>$(Il2CppDir)\Il2CppGame.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGame.Data"><HintPath>$(Il2CppDir)\Il2CppGame.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGame.Common"><HintPath>$(Il2CppDir)\Il2CppGame.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGame.Input"><HintPath>$(Il2CppDir)\Il2CppGame.Input.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppStr"><HintPath>$(Il2CppDir)\Il2CppStr.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(Il2CppDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Il2CppDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Il2CppDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>$(Il2CppDir)\UnityEngine.VideoModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Clean-room custom-song, audio, Addressables and data APIs. -->
    <Reference Include="Il2CppGame.UI.Common"><HintPath>$(Il2CppDir)\Il2CppGame.UI.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppGame.Audio"><HintPath>$(Il2CppDir)\Il2CppGame.Audio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFMODUnity"><HintPath>$(Il2CppDir)\Il2CppFMODUnity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFastText"><HintPath>$(Il2CppDir)\Il2CppFastText.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(Il2CppDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule"><HintPath>$(Il2CppDir)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule"><HintPath>$(Il2CppDir)\UnityEngine.UnityWebRequestWWWModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAssetBundleModule"><HintPath>$(Il2CppDir)\UnityEngine.UnityWebRequestAssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Il2CppDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(Il2CppDir)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(Il2CppDir)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(Il2CppDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\bomb.png"
          Link="InFalsusChartExt\bomb.png"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyNativeProfiles" AfterTargets="Build">
    <ItemGroup>
      <NativeProfileFile Include="Profiles\profiles\*.json" />
    </ItemGroup>
    <Copy SourceFiles="Profiles\native-profiles.json"
          DestinationFolder="$(OutDir)InFalsusChartExt" />
    <Copy SourceFiles="@(NativeProfileFile)"
          DestinationFolder="$(OutDir)InFalsusChartExt\profiles" />
  </Target>
</Project>
